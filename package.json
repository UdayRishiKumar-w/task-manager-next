{
  "name": "task-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm codegen && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:styles": "stylelint \"**/*.{css,scss,tsx,jsx,html}\"",
    "lint:styles:fix": "stylelint \"**/*.{css,scss,tsx,jsx,html}\" --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "codegen": "pnpm exec graphql-codegen --config codegen.ts",
    "codegen:watch": "pnpm codegen --watch",
    "codegen:check": "pnpm codegen --check",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@apollo/server": "^5.4.0",
    "@as-integrations/next": "^4.1.0",
