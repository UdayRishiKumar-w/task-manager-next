{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Override module resolution for Jest/Node environment
    "module": "commonjs",
    "moduleResolution": "node",

    // Enable ES module interop for Jest
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Ensure types are available in tests
    "types": ["jest", "node", "@testing-library/jest-dom"],

    // Allow importing JSON files in tests
    "resolveJsonModule": true,

    // Emit decorator metadata for testing frameworks that need it
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,

    // Ensure JSX works in test files
    "jsx": "react-jsx",

    // Disable noEmit since ts-jest needs to transform files
    "noEmit": false
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "jest.setup.ts",
    "src/test-utils.tsx",
    "src/__mocks__/**/*"
  ],
  "exclude": ["node_modules", "dist", "build", ".next", "coverage", "e2e"]
}
